Code "Knight Dynamics" by "Hypernova"
//
	#include "Reflection" noemit
	#lib "Reflection"
	#lib "Lua"
	#lib "GameObject"
	#lib "GameManager"
	#lib "EventPlayer"
	#lib "Player"
	
	#import "Services"
	#import "GOComponents"
	#import "Graphics"
	#import "Plugins"
	
	static long AddressSP02 = 0;
	static long F2SwordLast = 0;
	static long Address3120 = 0;
	static long Address3180 = 0;

	static long AtkIntrrupt = 0;
	static string[] IntrRNG = new[]
    { /* sup */ "battle1_interrupt", "battle2_interrupt" };
	
	static long B1SwordRage = 0;
	static string[] RageRNG = new[]
    { /* sup */ "battle1_sword_rage", "battle2_sword_vert", "battle1_sword_vert", };
	
	static long B1SwordSide = 0;
	static string[] SideRNG = new[]
    { /* sup */ "battle1_sword_side", "battle2_sword_vert", };
	
	static long B1SwordVert = 0;
	static string[] VertRNG = new[]
    { /* sup */ "battle1_sword_vert", "battle1_sword_rage", };
		
	static long SonicDamage = 0;
    static string[] HurtRNG = new[]
    { /* sup */ "zev_knight_sonic_damageX1", "zev_knight_sonic_damageX2", "zev_knight_sonic_damageX3", "zev_knight_sonic_damageX4", "zev_knight_sonic_damageX5", "zev_knight_sonic_damageX6", "zev_knight_sonic_damageX7", "zev_knight_sonic_damageX8", };
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;
	{
		if (Address3120 == 0) {/* 0x14145C100 */ Address3120 = ScanSignature ("bo3120", "xxxxxx");}
		
		bool gameModeBossRush = GameMode.GetName() == "GameModeBossRush"
		if (!gameModeBossRush)
		{ WriteProtected<byte>(Address3120, System.Text.Encoding.UTF8.GetBytes("bo3120"));}
		else
		{ WriteProtected<byte>(Address3120, System.Text.Encoding.UTF8.GetBytes("bo3122"));}
		
		string eventName = evtPlayer->GetCurrentEventName();
		switch (eventName)
		{
			case "bo3120":
			case "bo3122":
				WriteProtected<byte>(Address3180, System.Text.Encoding.UTF8.GetBytes("bo3180"));
				break;
			
			case "bo3140":
			case "bo3145":
				WriteProtected<byte>(Address3180, System.Text.Encoding.UTF8.GetBytes("bo3181"));
				break;	
		}
		
		bool isGiantBoss03 = (Player.State.GetStatePlugin("StatePluginBossBattle") != null) && (GameManager.GetGameObject("Knight0") != null);
		if (!isGiantBoss03)
			return;
		{
			if (Address3180 == 0) {/* 0x14145C2B4 */ Address3180 = ScanSignature ("bo3180", "xxxxxx");}
				
			var pkinematics = Player.Kinematics.Get();
				
			bool isRide01_Nrmal = evtPlayer->IsEventPlaying("zev_knight_shieldride01")
			bool isRide01_Short = evtPlayer->IsEventPlaying("zev_knight_shieldride01_short")
			bool isRide02_Nrmal = evtPlayer->IsEventPlaying("zev_knight_shieldride02")
			if ((isRide01_Nrmal) || (isRide01_Short) || (isRide02_Nrmal))
			{ pkinematics->Position = new System.Numerics.Vector3(350.310f, 600.000f, 847.872f); }
			
			bool isKnightF2 = evtPlayer->IsEventPlaying("bo3141")
			if (isKnightF2)
			{
				pkinematics->Position = new System.Numerics.Vector3(607.0f, 670.0f, 1085.0f);
				pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
			}
			
			if (AtkIntrrupt == 0) {/* 0x141459958 */ AtkIntrrupt = ScanSignature ("battle1_interrupt", "xxxxxxxxxxxxxxxxx");} // Phase 1 Counter Attack after Shieldride 
			if (B1SwordRage == 0) {/* 0x141459870 */ B1SwordRage = ScanSignature ("battle1_sword_rage", "xxxxxxxxxxxxxxxxxx");} // Sword Counter Phase 2
			if (B1SwordSide == 0) {/* 0x1414598A0 */ B1SwordSide = ScanSignature ("battle1_sword_side", "xxxxxxxxxxxxxxxxxx");} // Sword Attack Side Phase 1
			if (B1SwordVert == 0) {/* 0x141459888 */ B1SwordVert = ScanSignature ("battle1_sword_vert", "xxxxxxxxxxxxxxxxxx");} // Sword Attack Vertical Phase 1
			if (F2SwordLast == 0) {/* 0x14145C278 */ F2SwordLast = ScanSignature ("zev_knight_atk_sp01", "xxxxxxxxxxxxxxxxxxx");} // Sword Final QTE
			if (AddressSP02 == 0) {/* 0x14145C1F8 */ AddressSP02 = ScanSignature ("zev_knight_sonic_sp01_phase2", "xxxxxxxxxxxxxxxxxxxxxxxxxxxx");} // Grand Slam Phase 2
			
			if (SonicDamage == 0) // Sonic Damage Event
			{/* 0x141455908 */ SonicDamage = ScanSignature ("zev_knight_sonic_damage01", "xxxxxxxxxxxxxxxxxxxxxxxxx");}
			else
			{ WriteProtected<byte>(SonicDamage, System.Text.Encoding.UTF8.GetBytes(HurtRNG[new Random().Next(0, HurtRNG.Length)])); }
			
			bool gameModeBattleRush = GameMode.GetName() == "GameModeBattleRush"
			if (gameModeBossRush) // Master King
			{
				WriteProtected<byte>(AtkIntrrupt, System.Text.Encoding.UTF8.GetBytes(IntrRNG[new Random().Next(0, IntrRNG.Length)]));
				WriteProtected<byte>(B1SwordRage, System.Text.Encoding.UTF8.GetBytes(RageRNG[new Random().Next(0, RageRNG.Length)]));
				WriteProtected<byte>(B1SwordSide, System.Text.Encoding.UTF8.GetBytes(SideRNG[new Random().Next(0, SideRNG.Length)]));
				WriteProtected<byte>(B1SwordVert, System.Text.Encoding.UTF8.GetBytes(VertRNG[new Random().Next(0, VertRNG.Length)]));
				WriteProtected<byte>(F2SwordLast, System.Text.Encoding.UTF8.GetBytes("zev_knight_atk_sp03"));
				WriteProtected<byte>(AddressSP02, System.Text.Encoding.UTF8.GetBytes("zev_knight_sonic_sp02_phase2"));
					
				if (isKnightF2)
				{
					{ var setupData = new EventPlayer.EventSetupData("bo3145"); evtPlayer->PlayEvent(ref setupData); }
					{
						var setupData = new EventPlayer.EventSetupData("zev_knight_shieldride02_aerial");
						setupData.playFlags &= (EventPlayer.EventSetupData.PlayFlag)0xFFFFFFFB; //CantSkip//
						evtPlayer->PlayEvent(ref setupData);
					}
				};
			}
			else if (gameModeBattleRush) // Battle Rush
			{
				WriteProtected<byte>(AtkIntrrupt, System.Text.Encoding.UTF8.GetBytes("battle2_interrupt"));
				WriteProtected<byte>(B1SwordRage, System.Text.Encoding.UTF8.GetBytes(RageRNG[new Random().Next(0, RageRNG.Length)]));
				WriteProtected<byte>(B1SwordSide, System.Text.Encoding.UTF8.GetBytes("battle2_sword_vert"));
				WriteProtected<byte>(B1SwordVert, System.Text.Encoding.UTF8.GetBytes("battle1_sword_rage"));
				WriteProtected<byte>(F2SwordLast, System.Text.Encoding.UTF8.GetBytes("zev_knight_atk_sp02"));
				WriteProtected<byte>(AddressSP02, System.Text.Encoding.UTF8.GetBytes("zev_knight_sonic_sp01_phase2"));
					
				if (isKnightF2)
				{
					var setupData = new EventPlayer.EventSetupData("bo3140");
					evtPlayer->PlayEvent(ref setupData);
				}
			}
			else // Base Story
			{	
				WriteProtected<byte>(AtkIntrrupt, System.Text.Encoding.UTF8.GetBytes("battle1_interrupt"));
				WriteProtected<byte>(B1SwordRage, System.Text.Encoding.UTF8.GetBytes(RageRNG[new Random().Next(0, RageRNG.Length)]));
				WriteProtected<byte>(B1SwordSide, System.Text.Encoding.UTF8.GetBytes("battle1_sword_side"));
				WriteProtected<byte>(B1SwordVert, System.Text.Encoding.UTF8.GetBytes("battle1_sword_vert"));
				WriteProtected<byte>(F2SwordLast, System.Text.Encoding.UTF8.GetBytes("zev_knight_atk_sp01"));
				WriteProtected<byte>(AddressSP02, System.Text.Encoding.UTF8.GetBytes("zev_knight_sonic_sp01_phase2"));
				
				if (isKnightF2)
				{
					var setupData = new EventPlayer.EventSetupData("bo3140");
					evtPlayer->PlayEvent(ref setupData);
				}
			}
		}
	}
};
