	static long AddressSp01 = 0;
	static long AddressSnd1 = 0;
	static long AddressMsle = 0;
	static long AddressPsyc = 0;
	static long AddressFn01 = 0;
	static long AdCntrLsr01 = 0;
	static long Address2120 = 0;
	static long Address2180 = 0;
	
	static byte[] _gb0 = System.Text.Encoding.UTF8.GetBytes("bo2120");
	static byte[] _gb1 = System.Text.Encoding.UTF8.GetBytes("bo2121");
	static byte[] _gb2 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_missile");
	static byte[] _gb3 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_psycho");
	static byte[] _gb4 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_01");
	static byte[] _gb5 = System.Text.Encoding.UTF8.GetBytes("attack_counter01_r");
	static byte[] _gb6 = System.Text.Encoding.UTF8.GetBytes("bo2180");
	static byte[] _gb7 = System.Text.Encoding.UTF8.GetBytes("attack_counter03_r");
	static byte[] _gb8 = System.Text.Encoding.UTF8.GetBytes("bo2181");
	static byte[] _gb9 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_02");
	static byte[] _gb10 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_laser00");
	static byte[] _gb11 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_psych0");
	static byte[] _gb12 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_finish_00");
	static byte[] _gb13 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_X2");
	static byte[] _gb14 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_laser01");
	static byte[] _gb15 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_smash2");
	static byte[] _gb16 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_finish_01");
	static byte[] _gb17 = System.Text.Encoding.UTF8.GetBytes("zev_dragon_sp_F2");
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;
		
	string gameModeName = GameMode.GetName();
	bool gameModeBossRush = gameModeName == "GameModeBossRush"
	bool gameModeBattleRush = gameModeName == "GameModeBattleRush"
	
	if (AddressSp01 == 0) {/* 0x14144C9C0 */ AddressSp01 = ScanSignature ("zev_dragon_sp_01", "xxxxxxxxxxxxxxxx");}
	if (AdCntrLsr01 == 0) {/* 0x14144B308 */ AdCntrLsr01 = ScanSignature ("attack_counter01_r", "xxxxxxxxxxxxxxxxxx");}
	if (AddressMsle == 0) {/* 0x14144C9F8 */ AddressMsle = ScanSignature ("zev_dragon_sp_missile", "xxxxxxxxxxxxxxxxxxxxx");}
	if (AddressPsyc == 0) {/* 0x14144CA10 */ AddressPsyc = ScanSignature ("zev_dragon_sp_psycho", "xxxxxxxxxxxxxxxxxxxx");}
	if (AddressFn01 == 0) {/* 0x14144C9C0 */ AddressFn01 = ScanSignature ("zev_dragon_finish_01", "xxxxxxxxxxxxxxxxxxxx");}
	if (Address2120 == 0) {/* 0x14144C95C */ Address2120 = ScanSignature ("bo2120", "xxxxxx");}
	if (Address2180 == 0) {/* 0x14144C99D */ Address2180 = ScanSignature ("bo2180", "xxxxxx");}
	
	if (!gameModeBossRush)
	{ WriteProtected<byte>(Address2120, _gb0); }
	else
	{ WriteProtected<byte>(Address2120, _gb1); }
		
	if (evtPlayer->IsEventPlaying("bo2115"))
	{
		WriteProtected<byte>(AddressMsle, _gb2);
		WriteProtected<byte>(AddressPsyc, _gb3);
		WriteProtected<byte>(AddressSp01, _gb4);
		WriteProtected<byte>(AdCntrLsr01, _gb5);
		WriteProtected<byte>(Address2180, _gb6);
	}
		
	bool DragonFight = ((GameManager.GetGameObject("Dragon0") != null) && (Player.State.GetStatePlugin("StatePluginBossBattle") != null))
	if (!DragonFight) 
		return;
	{
		if (evtPlayer->IsEventPlaying("bo2141"))
		{
			var setupData = new EventPlayer.EventSetupData("bo2140");
			evtPlayer->PlayEvent(ref setupData);
		}
		
		if (evtPlayer->IsEventPlaying("bo2140"))
		{
			WriteProtected<byte>(AdCntrLsr01, _gb7);
			WriteProtected<byte>(Address2180, _gb8);
				
			if (gameModeBossRush)
			{ 
				WriteProtected<byte>(AddressSp01, _gb9);
				WriteProtected<byte>(AddressMsle, _gb10);
				WriteProtected<byte>(AddressPsyc, _gb11); 
				WriteProtected<byte>(AddressFn01, _gb12); 
				
				var setupData = new EventPlayer.EventSetupData("zev_dragon_sp_missile2");
				setupData.playFlags &= (EventPlayer.EventSetupData.PlayFlag)0xFFFFFFFB;
				evtPlayer->PlayEvent(ref setupData);
			}
			else if (gameModeBattleRush)
			{ 
				WriteProtected<byte>(AddressSp01, _gb13);
				WriteProtected<byte>(AddressMsle, _gb14);
				WriteProtected<byte>(AddressPsyc, _gb15);
				WriteProtected<byte>(AddressFn01, _gb16); 
					
				var setupData = new EventPlayer.EventSetupData("zev_dragon_sp_psych1");
				setupData.playFlags &= (EventPlayer.EventSetupData.PlayFlag)0xFFFFFFFB;
				evtPlayer->PlayEvent(ref setupData);
			}
			else
			{ 
				WriteProtected<byte>(AddressSp01, _gb17);
				WriteProtected<byte>(AddressMsle, _gb2);
				WriteProtected<byte>(AddressPsyc, _gb3);
				WriteProtected<byte>(AddressFn01, _gb16); 
			}
		}
		
		if ((evtPlayer->IsEventPlaying("zev_dragon_sp_laser00")) || (evtPlayer->IsEventPlaying("zev_dragon_sp_laser01")))
		{ WriteProtected<byte>(AddressMsle, _gb2); }
	}
