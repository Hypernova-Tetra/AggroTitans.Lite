Code "Giganto_Combat_1"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
    #import "Services"

	static long Address1120 = 0;
	static long Address1160 = 0;
	static bool ModsChecked = false;
	static bool isBSRActive = false;
	static byte[] _gb0 = System.Text.Encoding.UTF8.GetBytes("bo1120");
	static byte[] _gb1 = System.Text.Encoding.UTF8.GetBytes("bo1170");
	static byte[] _gb2 = System.Text.Encoding.UTF8.GetBytes("bo1160");
	static byte[] _gb3 = System.Text.Encoding.UTF8.GetBytes("bo1121");
	static byte[] _gb4 = System.Text.Encoding.UTF8.GetBytes("bo1161");
//
{	
	if (Address1120 == 0) { /* 0x1414534C8 */ Address1120 = ScanSignature ("bo1120", "xxxxxx"); }
	if (Address1160 == 0) { /* 0x141453520 */ Address1160 = ScanSignature ("bo1160", "xxxxxx"); }
		
	if (!ModsChecked) { isBSRActive = HMM.GetMods().Where(x => x.Name == "Boss Select Rematch").Count() > 0; ModsChecked = true; }
	string gameModeName = GameMode.GetName();
	bool gameModeBattleRush = gameModeName == "GameModeBattleRush"
	bool gameModeBossRush = gameModeName == "GameModeBossRush"
	
	if (gameModeBattleRush)
	{ 
		WriteProtected<byte>(Address1120, _gb0);
	
		if (isBSRActive)
		{ WriteProtected<byte>(Address1160, _gb1); }
		else
		{ WriteProtected<byte>(Address1160, _gb2); }
	}
    else if (gameModeBossRush)
	{ 
		WriteProtected<byte>(Address1120, _gb3);
		WriteProtected<byte>(Address1160, _gb4); 
	}
	else
	{ return; }
}

