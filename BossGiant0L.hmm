Code "Giganto_Combat_1"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
    #import "Services"

	static long Address1120 = 0;
	static long Address1160 = 0;
//
{	
	if (Address1120 == 0) { /* 0x1414534C8 */ Address1120 = ScanSignature ("bo1120", "xxxxxx"); }
	if (Address1160 == 0) { /* 0x141453520 */ Address1160 = ScanSignature ("bo1160", "xxxxxx"); }
		
	bool isBSRActive = HMM.GetMods().Where(x => x.Name == "Boss Select Rematch").Count() > 0;
	bool gameModeBattleRush = GameMode.GetName() == "GameModeBattleRush"
	bool gameModeBossRush = GameMode.GetName() == "GameModeBossRush"
	
	if (gameModeBattleRush)
	{ 
		WriteProtected<byte>(Address1120, System.Text.Encoding.UTF8.GetBytes("bo1120")); // Original Animation
	
		if (isBSRActive)
		{ WriteProtected<byte>(Address1160, System.Text.Encoding.UTF8.GetBytes("bo1170")); }
		else
		{ WriteProtected<byte>(Address1160, System.Text.Encoding.UTF8.GetBytes("bo1160")); }
	}
    else if (gameModeBossRush)
	{ 
		WriteProtected<byte>(Address1120, System.Text.Encoding.UTF8.GetBytes("bo1121")); // Tru-Blu Animation
		WriteProtected<byte>(Address1160, System.Text.Encoding.UTF8.GetBytes("bo1161")); 
	}
	else
	{ return; }
}

Code "Giganto Dynamics" by "Hypernova"
//
	#include "Reflection" noemit
	#lib "GameManager"
	#lib "Reflection"
	#lib "EventPlayer"
	#lib "GameObject"
	#lib "Lua"
	#lib "Player"
	
	#import "Services"
	#import "GOComponents"
	#import "Graphics"
	#import "Plugins"
	
	static long AdCyloopAtk = 0;
	static long AdCyloopPry = 0;
	static long AdAtkCnSp02 = 0;
	static long AttackShout = 0;
	
	static long Address1120 = 0;
	static long Address1160 = 0;
	static long Address1180 = 0;
//
{	
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;
	
	if (AttackShout == 0) { /* 0x1414508E8 */ AttackShout = ScanSignature ("attack_howl", "xxxxxxxxxxx"); }
	if (AdCyloopAtk == 0) { /* 0x14140F690 */ AdCyloopAtk = ScanSignature ("cyloop_counter", "xxxxxxxxxxxxxx"); }
	if (AdCyloopPry == 0) { /* 0x14140F6A0 */ AdCyloopPry = ScanSignature ("cyloop_counter_parry", "xxxxxxxxxxxxxxxxxxxx"); }
	if (AdAtkCnSp02 == 0) { /* 0x141451370 */ AdAtkCnSp02 = ScanSignature ("attack_counter_sp_02", "xxxxxxxxxxxxxxxxxxxx"); }
	if (Address1120 == 0) { /* 0x1414534C8 */ Address1120 = ScanSignature ("bo1120", "xxxxxx"); }
	if (Address1160 == 0) { /* 0x141453520 */ Address1160 = ScanSignature ("bo1160", "xxxxxx"); }
	if (Address1180 == 0) { /* 0x141453544 */ Address1180 = ScanSignature ("bo1180", "xxxxxx"); }
	
	bool isGiant01 = (GameManager.GetGameObject("Giant0") != null)
	if (!isGiant01)
		return;
	{	
		string eventName = evtPlayer->GetCurrentEventName();
		switch (eventName)
		{
			case "ga1225":
				WriteProtected<byte>(Address1120, System.Text.Encoding.UTF8.GetBytes("bo1122")); // Boi Animation
				WriteProtected<byte>(Address1160, System.Text.Encoding.UTF8.GetBytes("bo1151")); 
			break;
			
			case "bo1120": 
			case "bo1121":
			case "bo1122":
				WriteProtected<byte>(AttackShout, System.Text.Encoding.UTF8.GetBytes("attack_howl"));
				WriteProtected<byte>(AdCyloopAtk, System.Text.Encoding.UTF8.GetBytes("cyloop_counter"));
				WriteProtected<byte>(AdCyloopPry, System.Text.Encoding.UTF8.GetBytes("cyloop_counter_parry"));
				WriteProtected<byte>(AdAtkCnSp02, System.Text.Encoding.UTF8.GetBytes("attack_counter_sp_02"));
				WriteProtected<byte>(Address1180, System.Text.Encoding.UTF8.GetBytes("bo1180"));
			break;
			
			case "bo1141":
				WriteProtected<byte>(AttackShout, System.Text.Encoding.UTF8.GetBytes("atk_howl_02"));
				WriteProtected<byte>(AdCyloopAtk, System.Text.Encoding.UTF8.GetBytes("cyloop_attck_r"));
				WriteProtected<byte>(AdCyloopPry, System.Text.Encoding.UTF8.GetBytes("cyloop_counter_pry_r"));
				WriteProtected<byte>(Address1180, System.Text.Encoding.UTF8.GetBytes("bo1181"));
			break;
			
			case "bo1140":
				WriteProtected<byte>(AdAtkCnSp02, System.Text.Encoding.UTF8.GetBytes("attack_counter_sp_02"));
			break;
			
			case "bo1142":
				WriteProtected<byte>(AdAtkCnSp02, System.Text.Encoding.UTF8.GetBytes("attack_counter_sp_03"));
			break;
		}
	}
	
	bool isGiantSkipF2 = evtPlayer->IsEventPlaying("bo1141")
	if (!isGiantSkipF2) // This has to stay here outside of any inner bracket to function.
		return;
	{	
		var pkinematics = Player.Kinematics.Get();
		pkinematics->Position = new System.Numerics.Vector3(81.0f, 319.0f, -60.5f);
		pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 0.701707f, 0.0f, 0.701707f);
		
		if (GameMode.GetName() == "GameModeBossRush")
		{
			var setupData = new EventPlayer.EventSetupData("bo1142");
			evtPlayer->PlayEvent(ref setupData);
		}
		else
		{
			var setupData = new EventPlayer.EventSetupData("bo1140");
			evtPlayer->PlayEvent(ref setupData);
		}
	}
};
