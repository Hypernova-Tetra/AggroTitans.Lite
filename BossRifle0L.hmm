Patch "Supreme Address Edits" by "Hypernova"
//
	#lib "Memory"
	static byte[] _gb0 = System.Text.Encoding.UTF8.GetBytes("bo4141");
	static byte[] _gb1 = System.Text.Encoding.UTF8.GetBytes("ev503X");
	static byte[] _gb2 = System.Text.Encoding.UTF8.GetBytes("ev504X");
	static byte[] _gb3 = System.Text.Encoding.UTF8.GetBytes("ev603X");
//
{
	WriteProtected<byte> (/* 0x1414624C0 */ ScanSignature ("bo4140", "xxxxxx"), _gb0);
	WriteProtected<byte> (/* 0x14145D190 */ ScanSignature ("ev5030", "xxxxxx"), _gb1);
	WriteProtected<byte> (/* 0x1414348B4 */ ScanSignature ("ev5040", "xxxxxx"), _gb2);
	WriteProtected<byte> (/* 0x14143739C */ ScanSignature ("ev6030", "xxxxxx"), _gb3);
	
	// Shot2 = zev_rfl_sp02
    if(ScanSignature("\xB0\xFD\x02\x03\x4C\x8B\xC0\x48\x8B\xCB\xE8\x3D\x84\xF9\xFF\x48\x8B\x4C\x24\x58\x48\x85\xC9\x74\x05\xE8\x9E\xDD", "xxxxxxxxxxxxxxxxxxxxxxxxxxxx") == 0) 
    { WriteProtected<byte> (0x14145E9C0, new byte[] { 0x00, 0x3E, 0x32, 0x40, 0x01 }); }
    else 
    { WriteProtected<byte> (0x14145E9F0, new byte[] { 0x00, 0x3E, 0x32, 0x40, 0x01 }); }

	// Shot4 = zev_rfl_sp01
	if(ScanSignature("\xB0\xFD\x02\x03\x4C\x8B\xC0\x48\x8B\xCB\xE8\x3D\x84\xF9\xFF\x48\x8B\x4C\x24\x58\x48\x85\xC9\x74\x05\xE8\x9E\xDD", "xxxxxxxxxxxxxxxxxxxxxxxxxxxx") == 0) 
    { WriteProtected<byte> (0x1403239BB, new byte[] { 0x48, 0x8D, 0x15, 0x3E, 0xE5, 0x13, 0x01 }); }
    else 
    { WriteProtected<byte> (0x1403239BB, new byte[] { 0x48, 0x8D, 0x15, 0x6E, 0xE5, 0x13, 0x01 }); }
}

Code "Supreme Dynamics" by "Hypernova" rewritten by "Gordon Ramsay"
