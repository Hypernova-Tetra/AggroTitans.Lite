Code "Supreme moveset" by "Hypernova"
//
	#include "Reflection" noemit
	#lib "Reflection"
	#lib "EventPlayer"
    #lib "HMM"
	#lib "INI"
	#import "Services"
	
	static long Adr4110 = 0;
	static long Adr4160 = 0;
	static byte[] _gb0 = System.Text.Encoding.UTF8.GetBytes("bo4110");
	static byte[] _gb1 = System.Text.Encoding.UTF8.GetBytes("bo4160");
	static byte[] _gb2 = System.Text.Encoding.UTF8.GetBytes("bo4111");
	static byte[] _gb3 = System.Text.Encoding.UTF8.GetBytes("bo4162");
//
{
	if (Adr4110 == 0) { /* 0x1414624B0 */ Adr4110 = ScanSignature ("bo4110", "xxxxxx"); }
	if (Adr4160 == 0) { /* 0x1414624B8 */ Adr4160 = ScanSignature ("bo4160", "xxxxxx"); }
	
	bool isRifleBeast = (GameManager.GetGameObject("RifleBeast0") != null);
	if (!isRifleBeast)
	{
		WriteProtected<byte>(Adr4110, _gb0);
		WriteProtected<byte>(Adr4160, _gb1);
	}
	else
	{
		WriteProtected<byte>(Adr4110, _gb2);
		WriteProtected<byte>(Adr4160, _gb3);
	}
}

Code "Counter_Blow" by "Holoska"
//
	#import "Services"
	#import "GOComponents"
	#import "Graphics"
	#import "Plugins"
	#include "Reflection" noemit
	#lib "GameManager"
	#lib "GameObject"
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
	#lib "Player"
	
    static long AdRightHand = 0;	
	static string[] rng_counter = new[]
	{ /* sup */ 
	"attack_counter_righthand_01", "attack_counter_righthand_02", "attack_counter_righthand_03", "attack_counter_head_01␀␀␀␀␀",
	};	
	
	static long AdAtkCnSp02 = 0;
	static string[] rng_atksp02 = new[]
	{ /* sup */ 
	"attack_counter_sp_02", "attack_counter_sp_03", "attack_counter_sp_04", 
	};
{
	if (AdRightHand == 0) {/* 0x1414514C8 */ AdRightHand = ScanSignature ("attack_counter_righthand_01", "xxxxxxxxxxxxxxxxxxxxxxxxxxx");}
	if (AdAtkCnSp02 == 0) {/* 0x141451370 */ AdAtkCnSp02 = ScanSignature ("attack_counter_sp_02", "xxxxxxxxxxxxxxxxxxxx");}
	
	if ((GameManager.GetGameObject("Rifle0") != null) && (Player.State.GetStatePlugin("StatePluginBossBattle") != null))
	{ 
		WriteProtected<byte>(AdRightHand, System.Text.Encoding.UTF8.GetBytes(rng_counter[new Random().Next(0, rng_counter.Length)])); 
		WriteProtected<byte>(AdAtkCnSp02, System.Text.Encoding.UTF8.GetBytes(rng_atksp02[new Random().Next(0, rng_atksp02.Length)]));
	}
	else
	{ 
		WriteProtected<byte>(AdRightHand, System.Text.Encoding.UTF8.GetBytes("attack_counter_righthand_01"));
	}
}

Patch "Supreme Wing Laser"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
	#lib "GameMode"
    #import "Services"
    static bool IsConfigInitialised = false;
	static int RifleWing = 0;
	static long ATSHOT4 = 0;
	static byte[] _gb0 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_sp00␀␀␀");
	static byte[] _gb1 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_wng1␀␀␀");
	static byte[] _gb2 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_wng2␀␀␀");
//
{
    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("5664X0");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		RifleWing = INI.Parse<int>(ini["Main"]["BossRifleWing"], RifleWing);
        IsConfigInitialised = true;
			
		if (ATSHOT4 == 0) { /* 0x141461F00 */ ATSHOT4 = ScanSignature ("zev_rfl_sp01␀␀␀", "xxxxxxxxxxxxxxx"); }
		
		if (RifleWing == 0)
		{ WriteProtected<byte>(ATSHOT4, _gb0); }
		
		if (RifleWing == 1)
		{ WriteProtected<byte>(ATSHOT4, _gb1); }

		if (RifleWing == 2)
		{ WriteProtected<byte>(ATSHOT4, _gb2); }
	}
}
