	static byte[] _gb21 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_shootX1");
	static byte[] _gb22 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_bitlaserC2");
	static byte[] _gb23 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_bitlaser03");
	static byte[] _gb24 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_shoot03");
	static byte[] _gb25 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_lsX3");
	static byte[] _gb26 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_spK1");
	static byte[] _gb27 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_bitlaserA3");
	static byte[] _gb28 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_sp02");
	static byte[] _gb29 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_spK2");
	static byte[] _gb30 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_sp03");
	static byte[] _gb31 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_wing");
	static byte[] _gb32 = System.Text.Encoding.UTF8.GetBytes("zev_rfl_shootX2");
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;
	
	var pkinematics = Player.Kinematics.Get();
		
	if (Lua.Call<int>("IsPlayingDiEvent", "ev5020") == 1)
	{ 
		Lua.Call("SetLayerEnabled", "w1r04_plan_miniboss", false);
		Lua.Call("SetLayerEnabled", "w1r04_plan_common", false);
	}
	
	if (ATSHOTB == 0) { /* 0x141462108 */ ATSHOTB = ScanSignature ("zev_rfl_bitlaser02", "xxxxxxxxxxxxxxxxxx"); }
	if (ATSHOT3 == 0) { /* 0x141461EF0 */ ATSHOT3 = ScanSignature ("zev_rfl_laser01", "xxxxxxxxxxxxxxx"); }
	if (ATSHOT1 == 0) { /* 0x141461EE0 */ ATSHOT1 = ScanSignature ("zev_rfl_shoot02", "xxxxxxxxxxxxxxx"); }
	if (ATSHOT2 == 0) { /* 0x141461F10 */ ATSHOT2 = ScanSignature ("zev_rfl_sp02", "xxxxxxxxxxxx"); }
	if (Abo4180 == 0) { /* 0x1414624C8 */ Abo4180 = ScanSignature ("bo4180", "xxxxxx"); }
	if (AdCyAtk == 0) { /* 0x14140F690 */ AdCyAtk = ScanSignature ("cyloop_counter", "xxxxxxxxxxxxxx"); }
	if (AdCyPry == 0) { /* 0x14140F6A0 */ AdCyPry = ScanSignature ("cyloop_counter_parry", "xxxxxxxxxxxxxxxxxxxx"); }

	bool RifleBattle = ((Player.State.GetStatePlugin("StatePluginBossBattle") != null) && (GameManager.GetGameObject("Rifle0") != null))
	if (!RifleBattle) 
		return;
	{
		string eventName = evtPlayer->GetCurrentEventName();
		
		bool ZevRifle = ((evtPlayer != null) && (GameManager.GetGameObject("Rifle0") != null))
		if (!ZevRifle)
			return;
		{	
			WriteProtected<byte>(AdCyAtk, _gb0);
			WriteProtected<byte>(AdCyPry, _gb1);
			
			string gameModeName = GameMode.GetName();
			if (gameModeName == "GameModeBattleRush")
			{ WriteProtected<byte>(ATSHOT3, _gb2); }
			
			if (evtPlayer == null)
				return;
			{		
				bool isRifleBeast = (GameManager.GetGameObject("RifleBeast0") != null);
				bool gameModeBattleRush = (gameModeName == "GameModeBattleRush");
				
				if ((Lua.Call<int>("IsPlayingDiEvent", "bo4110") == 1) || (Lua.Call<int>("IsPlayingDiEvent", "ev1770") == 1))
				{ 
					pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
					pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 0.701707f, 0.0f, 0.701707f);
				}
				
				if (Lua.Call<int>("IsPlayingDiEvent", "bo4141") == 1)
				{ 		
					pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
					pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 0.701707f, 0.0f, 0.701707f);
					
					var setupData = new EventPlayer.EventSetupData("bo4140");
					evtPlayer->PlayEvent(ref setupData);
				}
		
				switch (eventName)
				{
					case "bo4110":
					case "bo4111":
					case "bo4180":
					case "bo4181":
					case "zev_rfl_start00":
						WriteProtected<byte>(ATSHOT3, _gb3);
						WriteProtected<byte>(ATSHOT1, _gb4);
						WriteProtected<byte>(ATSHOT2, _gb5);
						WriteProtected<byte>(Abo4180, _gb6);
						if (!isRifleBeast)
							WriteProtected<byte>(ATSHOTB, _gb7);
						else
							WriteProtected<byte>(ATSHOTB, _gb8);
						break;
					
					case "zev_rfl_bitlaser01":
						WriteProtected<byte>(ATSHOTB, _gb9);
						break;
						
					case "zev_rfl_bitlaserA1":
					case "zev_rfl_bitlaserC1":
					case "zev_rfl_bitlaserX1":
						WriteProtected<byte>(ATSHOTB, _gb10);
						break;
						
					case "zev_rfl_bitlaserB1":
						WriteProtected<byte>(ATSHOTB, _gb11);
						break;
					
					case "zev_rfl_laserX2":
					case "zev_rfl_laserX1":
						WriteProtected<byte>(ATSHOT3, _gb12);
						WriteProtected<byte>(ATSHOT1, _gb4);
						break;
					
					case "zev_rfl_laser02":
						WriteProtected<byte>(ATSHOT3, _gb13);
						break;			
						
					case "zev_rfl_laser01":
						WriteProtected<byte>(ATSHOT1, _gb3);
						break;			
					
					case "zev_rfl_ls03":
						WriteProtected<byte>(ATSHOT2, _gb14);
						break;
						
					case "zev_rfl_sp01":
						WriteProtected<byte>(ATSHOT2, _gb5);
						break;
					
					case "bo4140":	
						WriteProtected<byte>(ATSHOT1, _gb15);
						WriteProtected<byte>(ATSHOT2, _gb16);
						WriteProtected<byte>(Abo4180, _gb17);
						if (!isRifleBeast)
						{
							WriteProtected<byte>(ATSHOT3, _gb18);
							WriteProtected<byte>(ATSHOTB, _gb19);
						}
						else if (gameModeBattleRush)		
						{ 
							WriteProtected<byte>(ATSHOT3, _gb18);
							WriteProtected<byte>(ATSHOTB, _gb20);
						}
						else 
						{ 
							WriteProtected<byte>(ATSHOT3, _gb21);
							WriteProtected<byte>(ATSHOTB, _gb19);
						}
						break;
						
					case "zev_rfl_bitlaser02":
					case "zev_rfl_bitlaserC2":
						WriteProtected<byte>(ATSHOTB, _gb20);
						break;
					
					case "zev_rfl_bitlaserA2":
						WriteProtected<byte>(ATSHOTB, _gb22);
						break;
					
					case "zev_rfl_spK0":
					case "zev_rfl_wng1":
					case "zev_rfl_wng2":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
						pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
						WriteProtected<byte>(ATSHOTB, _gb23);
						WriteProtected<byte>(ATSHOT1, _gb24);
						break;
					
					case "zev_rfl_spKX":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
						pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
						if (!isRifleBeast) 
							WriteProtected<byte>(ATSHOT2, _gb25);
						else
							WriteProtected<byte>(ATSHOT2, _gb26);
						break;
						
					case "zev_rfl_bitlaser03":
						WriteProtected<byte>(ATSHOTB, _gb27);
						break;
							
					case "zev_rfl_bitlaserA3":
						WriteProtected<byte>(ATSHOTB, _gb20);
						break;
				
					case "zev_rfl_lsX3":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
						pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
						WriteProtected<byte>(ATSHOT2, _gb28);
						break;

					case "zev_rfl_spK1":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
						pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
						WriteProtected<byte>(ATSHOT2, _gb29);
						break;

					case "zev_rfl_sp02":
					case "zev_rfl_spK2":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
						pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
						WriteProtected<byte>(ATSHOT2, _gb30);
						break;
					
					case "zev_rfl_sp03":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
						pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
						WriteProtected<byte>(ATSHOT2, _gb31);
						break;

					case "zev_rfl_wing":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
						pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
						WriteProtected<byte>(ATSHOT2, _gb16);
						break;
				
					case "zev_rfl_shoot03":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
						pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
						WriteProtected<byte>(ATSHOT1, _gb15);
						break;
						
					case "zev_rfl_shoot02":
						pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
